# Kernel config fragment for options B and C (no-MCU adapters) on a TI AM62x host.
# Merge with: scripts/kconfig/merge_config.sh .config kernel.config
# Check a running board with: zcat /proc/config.gz | grep -E 'AX8817X|CP210X|DWC3'

# --- AX88772C (options B and C) -> eth2 ---
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m

# --- CP2102N management serial port (option C only) ---
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m

# --- AM62x USB host controller: Synopsys DWC3 with TI AM62 glue (xHCI host) ---
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_AM62=y
